# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
r_package/*.Rcheck/
renv/library/
renv/staging/

# Data (raw/large data never committed; see data/README.md for provenance)
data/raw/
data/interim/
data/processed/
*.h5ad
*.h5
*.loom
*.bam
*.bai
*.fastq.gz
*.fq.gz
# ...except tiny bundled test fixtures, which are meant to be committed (standard R
# package convention for @examples/testthat data — see ADR-0004).
!r_package/**/inst/extdata/*.fastq.gz

# Environments / secrets
.env
*.env.local

# Docs build
docs/_site/
docs/.quarto/
paper/_output/

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code local session state (not part of project config)
.claude/

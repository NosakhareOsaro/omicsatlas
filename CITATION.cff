    given-names: Nosakhare Odionfo
    email: osaronosakhare@gmail.com
license: MIT
repository-code: "https://github.com/NosakhareOsaro/omicsatlas"
version: 0.1.0.dev0
date-released: "2026-07-28"
keywords:
  - bioinformatics
  - single-cell RNA-seq
  - spatial transcriptomics
  - ATAC-seq
  - bulk RNA-seq
  - deconvolution
  - breast cancer
